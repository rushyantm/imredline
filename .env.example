# IMRedline — every variable it reads. Copy what you need into Railway / .env.
IMREDLINE_ADMIN_TOKEN=            # owner: one link arms the widget AND opens the queue
IMREDLINE_ADMIN_NAME=owner        # optional, appears as the reviewer name
IMREDLINE_REVIEWERS=              # "name:secret,name:secret" — never-expiring reviewer links
IMREDLINE_GITHUB_TOKEN=           # fine-grained PAT: Contents R/W + Issues R/W on ONE repo
IMREDLINE_GITHUB_REPO=            # owner/repo — this site's own repo
IMREDLINE_SITE=                   # optional short label → `site:<label>` on every issue
IMREDLINE_ORIGINS=                # optional, comma list of third-party origins allowed to post
IMREDLINE_DATA_DIR=.imredline     # where minted reviewer links (hashes only) live
IMREDLINE_MASK_FORMS=             # "1" blanks form fields in screenshots (default off)
IMREDLINE_BASE=/_imredline        # mount path
